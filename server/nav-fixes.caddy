# Wspólna baza poprawek tras pod /fixes (dołączany z /etc/caddy/conf.d/ do bloku 188-68-247-201.sslip.io)
@navfixes path /fixes /fixes/*
handle @navfixes {
	uri strip_prefix /fixes
	header >Access-Control-Allow-Origin "https://lewym90.github.io"
	header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type"
	header Vary "Origin"
	@pre method OPTIONS
	respond @pre 204
	reverse_proxy 127.0.0.1:18788 {
		header_down -Access-Control-Allow-Origin
	}
}
